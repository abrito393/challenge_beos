APP_NAME="Products API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=products_api
DB_USERNAME=products_api
# Local-only dummy credentials (Constitution III.6). Never reuse outside Docker.
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=33060

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Sanctum personal access tokens lifetime in minutes (ADR-0008).
SANCTUM_EXPIRATION=1440

# Reference currency for exchange rates (ADR-0004).
CURRENCY_REFERENCE=USD
