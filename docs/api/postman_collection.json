    {
      "name": "2. Currencies",
      "item": [
        {
          "name": "List currencies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/currencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "currencies"
              ]
            },
            "description": "Guarda los ids de USD, EUR y MXN para los siguientes requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json().data;",
                  "const id = code => list.find(c => c.code === code).id;",
                  "pm.test(\"exchange_rate is a decimal string\", () => pm.expect(list[0].exchange_rate).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"usdId\", id(\"USD\")); pm.collectionVariables.set(\"eurId\", id(\"EUR\")); pm.collectionVariables.set(\"mxnId\", id(\"MXN\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Products",
      "item": [
        {
          "name": "List products (filters + sort)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?filter[name]=laptop&filter[min_price]=100&sort=-price&per_page=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "filter[name]",
                  "value": "laptop"
                },
                {
                  "key": "filter[min_price]",
                  "value": "100"
                },
                {
                  "key": "sort",
                  "value": "-price"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Filtros: `filter[name]`, `filter[currency_id]`, `filter[min_price]`, `filter[max_price]`. Orden: `name`, `price`, `created_at` (prefijo `-` = descendente). `per_page` máx. 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Paginated\", () => pm.expect(pm.response.json()).to.have.keys(\"data\",\"links\",\"meta\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
